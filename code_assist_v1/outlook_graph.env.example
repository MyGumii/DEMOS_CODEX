# Microsoft Graph single-tenant server settings.
# This file is documentation only; app_notion.py does not load it automatically.
CODE_ASSIST_MS_TENANT_ID=00000000-0000-0000-0000-000000000000
CODE_ASSIST_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
CODE_ASSIST_MS_CLIENT_SECRET_FILE=G:\secure\notion-graph-client-secret.txt
CODE_ASSIST_MS_REDIRECT_URI=https://notion.example.com/api/notion/outlook/oauth/callback
CODE_ASSIST_MS_TOKEN_KEY_FILE=G:\secure\notion-outlook-token.key

# Optional override. HTTPS Graph deployments automatically use Secure cookies.
# CODE_ASSIST_SESSION_COOKIE_SECURE=true
