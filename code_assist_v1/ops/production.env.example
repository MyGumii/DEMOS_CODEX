# Copy to the protected environment_file named by the reviewed deployment manifest.
# UTF-8 without BOM, LF only, final LF. Never add process-role/path/test/failpoint keys.
CODE_ASSIST_ALLOWED_ORIGINS=http://127.0.0.1:10011,http://127.0.0.1:10012,https://code-assist.example.internal
# Required in the company deployment: a reviewed repository-external model
# registry whose hash is copied into the approval packet. Never store provider
# credentials in that JSON; inject them through the company secret store.
CODE_ASSIST_API_CONFIG=C:\CodeAssist\config\api_config.json
CODE_ASSIST_SESSION_COOKIE_SECURE=1
CODE_ASSIST_ALLOW_SIGNUP=0
CODE_ASSIST_ENABLE_CODEX_BRIDGE=0
KNOWLEDGE_CORE_ENABLED=0
KNOWLEDGE_CORE_MULTI_WIKI_SCHEMA=0
KNOWLEDGE_CORE_MULTI_WIKI_READS=0
KNOWLEDGE_CORE_MULTI_WIKI_WRITES=0
KNOWLEDGE_CORE_CONVERSATION_WIKI_BINDING=0
KNOWLEDGE_CORE_READS=0
KNOWLEDGE_CORE_PERSONAL_WRITES=0
KNOWLEDGE_CORE_PART_READS=0
KNOWLEDGE_CORE_PART_WRITES=0
KNOWLEDGE_CORE_PROJECTIONS=0
KNOWLEDGE_CORE_HIGHER_SPACES=0
KNOWLEDGE_CORE_AGGREGATE_GRAPH_READS=0
KNOWLEDGE_CORE_AUTO_SEMANTIC_EDGES_LOCAL=0
KNOWLEDGE_CORE_AUTO_SEMANTIC_EDGES_AGGREGATE=0
