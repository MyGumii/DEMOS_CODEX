        "n_threads": 8,
        "n_threads_env": "CODE_ASSIST_GGUF_N_THREADS",
        "n_threads_batch": 8,
        "n_threads_batch_env": "CODE_ASSIST_GGUF_N_THREADS_BATCH",
        "chat_handlers": [
