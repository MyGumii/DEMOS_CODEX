  "acknowledgement_contract": {
    "unit": "Unicode extended grapheme cluster after NFC normalization",
    "ack_point": "canonical authority durably accepts a client operation id and request hash",
    "zero_loss_rule": "Every acknowledged grapheme id appears exactly once in every converged visible state unless a causally authorized explicit delete names that exact id.",
    "duplicate_rule": "Duplicate delivery of one operation id never duplicates a grapheme or structural effect.",
    "delete_rule": "A structural conflict may retain, relocate, or tombstone a target according to the typed-command policy, but may not silently discard acknowledged rich text.",
    "ime_rule": "compositionstart and compositionupdate are local ephemeral state; one compositionend produces one acknowledged commit and one local undo unit.",
    "acknowledged_character_loss_budget": 0,
    "convergence_mismatch_budget": 0,
    "invalid_unicode_budget": 0
  },
  "actors": [
