    {"id": "guest", "stable_rank": 30}
  ],
  "delivery_schedules": [
    {
      "id": "CAUSAL_FORWARD",
      "rule": "Deliver every operation after all causally_after dependencies, then by actor stable_rank and operation id."
    },
    {
      "id": "CONCURRENT_REVERSE",
      "rule": "Within each causally ready set, deliver by descending actor stable_rank and descending operation id."
    },
    {
      "id": "DUPLICATE_EVERY_UPDATE",
      "rule": "Deliver every encoded update twice while preserving causal readiness."
    },
    {
      "id": "DETERMINISTIC_OUT_OF_ORDER",
      "rule": "Deliver a fixed non-causal wire order, buffer missing dependencies, then drain deterministically."
    },
    {
      "id": "RESTART_AFTER_HALF",
      "rule": "Persist the first deterministic half, close the process, reopen from durable state, and deliver the remainder."
    },
    {
      "id": "COMPACT_THEN_TAIL_REPLAY",
      "rule": "Verify and persist a checkpoint at the declared high-water, compact eligible history, then replay the tail twice."
    }
  ],
  "assertion_definitions": [
    {"id": "CONVERGED_CANONICAL_HASH", "rule": "Every replica and delivery schedule has one equal canonical document hash."},
    {"id": "ZERO_ACKNOWLEDGED_GRAPHEME_LOSS", "rule": "No acknowledged grapheme is absent without a causal explicit delete."},
    {"id": "NO_DUPLICATE_ACKNOWLEDGED_GRAPHEME", "rule": "No acknowledged grapheme id is visible more than once."},
    {"id": "NFC_AND_UNICODE_VALID", "rule": "All visible strings are NFC and contain valid Unicode scalar sequences."},
    {"id": "TYPED_STRUCTURE_VALID", "rule": "The block tree and database model satisfy their typed structural invariants."},
    {"id": "LOCAL_UNDO_PRESERVES_REMOTE", "rule": "Local undo removes only the local tracked origin and preserves concurrent remote effects."},
    {"id": "IME_INTERMEDIATE_NOT_BROADCAST", "rule": "No compositionupdate value becomes a durable or remote operation."},
    {"id": "IME_COMMIT_ONE_UNDO_UNIT", "rule": "Each compositionend commit is exactly one acknowledged local undo unit."},
    {"id": "RESTART_REPLAY_EQUIVALENT", "rule": "Restarted replay equals uninterrupted replay and contains no duplicate durable operation."},
    {"id": "COMPACTION_EQUIVALENT", "rule": "Checkpoint plus tail replay equals full-history replay."}
  ],
