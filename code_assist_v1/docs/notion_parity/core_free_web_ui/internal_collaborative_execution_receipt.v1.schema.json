{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-assist.local/schemas/internal-collaborative-execution-receipt-v1.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "receipt_id", "run_id", "rung_id", "lane_id",
    "packet_ids", "matrix_row_ids", "scenario_ids", "evidence_type",
    "mode", "release_candidate_id", "realm_id", "realm_config_fingerprint",
    "source_manifest_sha256", "validation_manifest_sha256",
    "schema_catalog_sha256", "current_schema_lineage_sha256",
    "agents_md_sha256", "goal_observation_sha256", "goal_thread_id",
    "goal_status_observed", "cross_catalog_ownership_snapshot_sha256",
    "working_directory", "argv", "environment_class", "tool_versions",
    "toolchain_fingerprint", "temp_root_id", "started_at", "ended_at",
    "duration_ms", "exit_code", "exit_code_signed", "exit_code_hex",
    "passed", "failed", "errors", "skipped", "xfailed", "result",
    "attempt", "retry_class", "source_pre_sha256", "source_post_sha256",
    "isolation_attestation", "owned_process_cleanup", "cleanup_attestation",
    "artifact_hashes", "redaction_summary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "rung_id": {"type": "string", "minLength": 1},
    "lane_id": {"type": "string", "minLength": 1},
    "packet_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "matrix_row_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "evidence_type": {"type": "string", "minLength": 1},
    "mode": {"enum": ["audit", "gate"]},
    "release_candidate_id": {"type": "string"},
    "realm_id": {"type": "string"},
    "realm_config_fingerprint": {"type": "string"},
    "source_manifest_sha256": {"type": "string"},
    "validation_manifest_sha256": {"type": "string"},
    "schema_catalog_sha256": {"type": "string"},
    "current_schema_lineage_sha256": {"type": "string"},
    "agents_md_sha256": {"type": "string"},
    "goal_observation_sha256": {"type": "string"},
    "goal_thread_id": {"type": "string"},
    "goal_status_observed": {"type": "string"},
    "cross_catalog_ownership_snapshot_sha256": {"type": "string"},
    "working_directory": {"type": "string"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "environment_class": {"type": "string"},
    "tool_versions": {"type": "object"},
    "toolchain_fingerprint": {"type": "string"},
    "temp_root_id": {"type": ["string", "null"]},
    "started_at": {"type": "string"},
    "ended_at": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "exit_code": {"type": "integer"},
    "exit_code_signed": {"type": "integer"},
    "exit_code_hex": {"type": "string"},
    "passed": {"type": "integer", "minimum": 0},
    "failed": {"type": "integer", "minimum": 0},
    "errors": {"type": "array"},
    "skipped": {"type": "integer", "minimum": 0},
    "xfailed": {"type": "integer", "minimum": 0},
    "result": {"enum": ["passed", "failed", "host_flaky", "infra_blocked", "evidence_missing", "infrastructure_failure", "not_run"]},
    "attempt": {"type": "integer", "minimum": 1},
    "retry_class": {"type": "string"},
    "source_pre_sha256": {"type": "object"},
    "source_post_sha256": {"type": "object"},
    "isolation_attestation": {"type": "object"},
    "owned_process_cleanup": {"type": "object"},
    "cleanup_attestation": {"type": "object"},
    "artifact_hashes": {"type": "object"},
    "redaction_summary": {"type": "object"}
  }
}
