{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-assist.local/contracts/knowledge.schema.json",
  "title": "Knowledge read, lease, revision, lifecycle, and graph contracts",
  "$defs": {
    "ItemState": {"enum": ["active", "inactive", "merged", "purged_tombstone"]},
    "CurationState": {"enum": ["provisional", "published", "quarantined"]},
    "AggregateOrigin": {"enum": ["native", "inherited", "overlay"]},
    "Capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "ItemSummary": {
      "type": "object",
      "required": ["id", "space_id", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id", "capabilities", "title", "state", "curation_state", "current_revision_id", "row_version", "updated_at"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "capabilities": {"$ref": "#/$defs/Capabilities"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "state": {"$ref": "#/$defs/ItemState"},
        "curation_state": {"$ref": "#/$defs/CurationState"},
        "current_revision_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "warning_badges": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "row_version": {"type": "integer", "minimum": 1},
        "updated_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"}
      },
      "additionalProperties": false
    },
    "ItemListResponse": {
      "type": "object",
      "required": ["request_id", "corpus_closure_sha256", "items", "next_cursor", "has_more"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ItemSummary"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "has_more": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ItemSourceArtifact": {
      "type": "object",
      "required": ["artifact_id", "created_at", "download_url", "media_type", "origin_type", "original_filename", "size_bytes", "source_revision_id"],
      "properties": {
        "artifact_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "download_url": {"type": "string", "format": "uri-reference", "pattern": "^/api/knowledge/v1/spaces/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}/items/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}/source-artifacts/[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}/download$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "origin_type": {"enum": ["upload", "notion", "chat", "manual", "legacy"]},
        "original_filename": {"type": "string", "minLength": 1, "maxLength": 240},
        "size_bytes": {"type": "integer", "minimum": 0},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"}
      },
      "additionalProperties": false
    },
    "ItemSourceArtifactListResponse": {
      "type": "object",
      "required": ["request_id", "corpus_closure_sha256", "item_id", "selected_view_space_id", "items"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ItemSourceArtifact"}}
      },
      "additionalProperties": false
    },
    "LeaseSummary": {
      "type": ["object", "null"],
      "properties": {
        "held": {"const": true},
        "holder_user_id": {"$ref": "common.schema.json#/$defs/UserId"},
        "holder_display": {"type": "string", "minLength": 1, "maxLength": 300},
        "fencing_generation": {"type": "integer", "minimum": 1},
        "heartbeat_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "expires_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"}
      },
      "required": ["held", "holder_user_id", "holder_display", "fencing_generation", "heartbeat_at", "expires_at"],
      "additionalProperties": false
    },
    "ItemTimeline": {
      "type": "object",
      "required": ["content_age_seconds", "content_created_at", "last_reviewed_at", "last_updated_at", "review_age_seconds"],
      "properties": {
        "content_age_seconds": {"type": "integer", "minimum": 0},
        "content_created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "last_reviewed_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/UtcTimestamp"}, {"type": "null"}]},
        "last_updated_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "review_age_seconds": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": false
    },
    "EdgeCounts": {
      "type": "object",
      "required": ["active_incoming", "active_outgoing", "inactive_incoming", "inactive_outgoing", "total"],
      "properties": {
        "active_incoming": {"type": "integer", "minimum": 0},
        "active_outgoing": {"type": "integer", "minimum": 0},
        "inactive_incoming": {"type": "integer", "minimum": 0},
        "inactive_outgoing": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ReferenceCounts": {
      "type": "object",
      "required": ["active_incoming", "active_outgoing", "conversation_pins", "inactive_incoming", "inactive_outgoing", "total"],
      "properties": {
        "active_incoming": {"type": "integer", "minimum": 0},
        "active_outgoing": {"type": "integer", "minimum": 0},
        "conversation_pins": {"type": "integer", "minimum": 0},
        "inactive_incoming": {"type": "integer", "minimum": 0},
        "inactive_outgoing": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "DeactivationSummary": {
      "type": ["object", "null"],
      "required": ["deactivated_at", "deactivated_by", "episode_id", "episode_no", "inactive_duration_seconds", "purge_eligible_at", "reason"],
      "properties": {
        "deactivated_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "deactivated_by": {
          "type": "object",
          "required": ["display_name", "user_id"],
          "properties": {
            "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
            "user_id": {"$ref": "common.schema.json#/$defs/UserId"}
          },
          "additionalProperties": false
        },
        "episode_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "episode_no": {"type": "integer", "minimum": 1},
        "inactive_duration_seconds": {"type": "integer", "minimum": 0},
        "purge_eligible_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "ItemLifecycleSummary": {
      "type": "object",
      "required": ["deactivation", "edge_counts", "reference_counts"],
      "properties": {
        "deactivation": {"$ref": "#/$defs/DeactivationSummary"},
        "edge_counts": {"$ref": "#/$defs/EdgeCounts"},
        "reference_counts": {"$ref": "#/$defs/ReferenceCounts"}
      },
      "additionalProperties": false
    },
    "ExplicitReferenceTarget": {
      "type": "object",
      "required": ["item_id", "observed_revision_id", "current_revision_id", "title", "source_space_id", "origin", "inherited", "newer_revision_available"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "observed_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "current_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "inherited": {"type": "boolean"},
        "newer_revision_available": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ExplicitReference": {
      "type": "object",
      "required": ["id", "ordinal", "syntax_version", "availability_status", "unavailable_reason", "target"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 1000},
        "syntax_version": {"const": "item-ref-v1"},
        "availability_status": {"enum": ["available", "unavailable"]},
        "unavailable_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "target": {
          "oneOf": [
            {"$ref": "#/$defs/ExplicitReferenceTarget"},
            {"type": "null"}
          ]
        }
      },
      "additionalProperties": false
    },
    "ItemResponse": {
      "type": "object",
      "required": ["request_id", "item", "markdown", "capabilities", "lease", "lifecycle", "references", "timeline", "corpus_closure_sha256", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "item": {"$ref": "#/$defs/ItemSummary"},
        "markdown": {"type": ["string", "null"]},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "lease": {"$ref": "#/$defs/LeaseSummary"},
        "lifecycle": {"$ref": "#/$defs/ItemLifecycleSummary"},
        "references": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/ExplicitReference"}},
        "timeline": {"$ref": "#/$defs/ItemTimeline"}
      },
      "additionalProperties": false
    },
    "Revision": {
      "type": "object",
      "required": ["id", "item_id", "revision_no", "parent_revision_id", "base_revision_id", "title", "change_kind", "content_sha256", "content_size_bytes", "normalized_content_sha256", "normalizer_version", "body_present", "created_by", "created_by_display", "created_at", "reason"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "parent_revision_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "base_revision_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "title": {"type": "string", "minLength": 1, "maxLength": 500},
        "change_kind": {"enum": ["initial", "edit", "merge", "import", "approved_update"]},
        "content_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "content_size_bytes": {"type": "integer", "minimum": 0},
        "normalized_content_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "normalizer_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "body_present": {"type": "boolean"},
        "markdown": {"type": ["string", "null"]},
        "created_by": {"$ref": "common.schema.json#/$defs/UserId"},
        "created_by_display": {"type": "string", "minLength": 1, "maxLength": 200},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "RevisionListResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor", "has_more", "corpus_closure_sha256", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Revision"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "has_more": {"type": "boolean"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"}
      },
      "additionalProperties": false
    },
    "RevisionResponse": {
      "type": "object",
      "required": ["request_id", "revision", "corpus_closure_sha256", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "revision": {"$ref": "#/$defs/Revision"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"}
      },
      "additionalProperties": false
    },
    "CompareResponse": {
      "type": "object",
      "required": ["request_id", "from_revision_id", "to_revision_id", "diff_format", "hunks", "diff_sha256", "corpus_closure_sha256", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "from_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "to_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "diff_format": {"const": "unified-v1"},
        "hunks": {"type": "array", "items": {"$ref": "#/$defs/DiffHunk"}},
        "diff_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"}
      },
      "additionalProperties": false
    },
    "DiffHunk": {
      "type": "object",
      "required": ["from_start", "from_count", "to_start", "to_count", "lines"],
      "properties": {
        "from_start": {"type": "integer", "minimum": 1},
        "from_count": {"type": "integer", "minimum": 0},
        "to_start": {"type": "integer", "minimum": 1},
        "to_count": {"type": "integer", "minimum": 0},
        "lines": {"type": "array", "items": {"type": "string"}, "maxItems": 40000}
      },
      "additionalProperties": false
    },
    "SearchRequest": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 2000},
        "limit": {"type": "integer", "minimum": 1, "maximum": 100},
        "cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "include_management_states": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "SearchHit": {
      "type": "object",
      "required": ["item_id", "revision_id", "title", "snippet", "score", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id", "capabilities"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "title": {"type": "string"},
        "snippet": {"type": "string"},
        "score": {"type": "number"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "capabilities": {"$ref": "#/$defs/Capabilities"}
      },
      "additionalProperties": false
    },
    "SearchResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor", "has_more", "space_id", "corpus_closure_sha256"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/SearchHit"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "has_more": {"type": "boolean"},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      },
      "additionalProperties": false
    },
    "GraphResponse": {
      "type": "object",
      "required": ["request_id", "space_id", "generation", "nodes", "edges", "corpus_closure_sha256"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "generation": {"type": "integer", "minimum": 0},
        "nodes": {"type": "array", "items": {"type": "object"}},
        "edges": {"type": "array", "items": {"type": "object"}},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      },
      "additionalProperties": false
    },
    "ActivityActor": {
      "type": "object",
      "required": ["display_name", "kind", "role_snapshot", "user_id"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 200},
        "kind": {"enum": ["user", "system"]},
        "role_snapshot": {"type": "string", "minLength": 1, "maxLength": 200},
        "user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/UserId"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "ActivityEvent": {
      "type": "object",
      "required": ["action", "actor", "base_revision_id", "event_uuid", "item_id", "new_revision_id", "occurred_at", "outcome", "reason", "space_id", "source_space_id", "selected_view_space_id", "inherited", "origin", "overlay_grant_id", "capabilities"],
      "properties": {
        "action": {"type": "string", "minLength": 1, "maxLength": 120},
        "actor": {"$ref": "#/$defs/ActivityActor"},
        "base_revision_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "event_uuid": {"$ref": "common.schema.json#/$defs/Uuid"},
        "item_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "new_revision_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "occurred_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "outcome": {"type": "string", "minLength": 1, "maxLength": 80},
        "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"$ref": "#/$defs/AggregateOrigin"},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "capabilities": {"$ref": "#/$defs/Capabilities"}
      },
      "additionalProperties": false
    },
    "ActivityResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor", "has_more", "corpus_closure_sha256"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/ActivityEvent"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "has_more": {"type": "boolean"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      },
      "additionalProperties": false
    },
    "AcquireLeaseRequest": {
      "type": "object",
      "required": ["operation_id", "editor_session_id"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"}
      },
      "additionalProperties": false
    },
    "LeaseResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "lease_id", "fencing_generation", "base_revision_id", "expires_at", "absolute_expires_at"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "lease_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "fencing_generation": {"type": "integer", "minimum": 1},
        "base_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "expires_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "absolute_expires_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"}
      },
      "additionalProperties": false
    },
    "HeartbeatLeaseRequest": {
      "type": "object",
      "required": ["editor_session_id", "lease_id"],
      "properties": {
        "editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "lease_id": {"$ref": "common.schema.json#/$defs/Uuid"}
      },
      "additionalProperties": false
    },
    "HeartbeatLeaseResponse": {
      "type": "object",
      "required": ["request_id", "lease_id", "fencing_generation", "expires_at"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "lease_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "fencing_generation": {"type": "integer", "minimum": 1},
        "expires_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"}
      },
      "additionalProperties": false
    },
    "ReleaseLeaseRequest": {
      "type": "object",
      "required": ["operation_id", "editor_session_id", "lease_id"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"},
