{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-assist.local/contracts/backup-manifest.schema.json",
  "title": "Verified SQLite snapshot and immutable blob backup manifest",
  "$defs": {
    "VersionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,79}$"
    },
    "BackupBlob": {
      "type": "object",
      "required": ["sha256", "size_bytes", "relative_path", "status", "copied_at", "verified_at", "error"],
      "properties": {
        "sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "relative_path": {"type": "string", "pattern": "^blobs/[0-9a-f]{2}/[0-9a-f]{2}/[0-9a-f]{64}$", "maxLength": 1000},
        "status": {"const": "verified"},
        "copied_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "verified_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "error": {"type": "null"}
      },
      "additionalProperties": false
    },
    "BackupManifest": {
      "type": "object",
      "required": [
        "manifest_schema_version", "backup_run_id", "state", "app_name",
        "app_version", "build_revision", "schema_version",
        "physical_schema_version", "schema_catalog_sha256",
        "physical_schema_sha256", "sqlite_version", "sqlite_source_id",
        "snapshot_db_relative_path", "snapshot_db_sha256",
        "snapshot_db_size_bytes", "snapshot_audit_high_water", "blobs",
        "blob_count", "blob_bytes", "blobs_sha256", "configuration_version",
        "lease_hmac_key_set_version", "manifest_sha256", "created_at",
        "completed_at", "quick_check", "foreign_key_violation_count"
      ],
      "properties": {
        "manifest_schema_version": {"const": 1},
        "backup_run_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "state": {"const": "verified"},
        "app_name": {"const": "code-assist"},
        "app_version": {"type": "string", "minLength": 1, "maxLength": 80},
        "build_revision": {"$ref": "common.schema.json#/$defs/Sha256"},
        "schema_version": {"const": 1},
        "physical_schema_version": {"const": 7},
        "schema_catalog_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "physical_schema_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "sqlite_version": {"const": "3.53.4"},
        "sqlite_source_id": {"const": "2026-07-24 19:02:57 bf7c7f30031888f4e796e429ab3978879485813aaca6f641c7b33e4e09459bcc"},
        "snapshot_db_relative_path": {"const": "database/knowledge-core.sqlite"},
        "snapshot_db_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "snapshot_db_size_bytes": {"type": "integer", "minimum": 0},
        "snapshot_audit_high_water": {"type": "integer", "minimum": 0},
        "blobs": {"type": "array", "items": {"$ref": "#/$defs/BackupBlob"}},
        "blob_count": {"type": "integer", "minimum": 0},
        "blob_bytes": {"type": "integer", "minimum": 0},
        "blobs_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "configuration_version": {"$ref": "#/$defs/VersionId"},
        "lease_hmac_key_set_version": {"$ref": "#/$defs/VersionId"},
        "manifest_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "completed_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "quick_check": {"const": "ok"},
        "foreign_key_violation_count": {"const": 0}
      },
      "additionalProperties": false
    }
  }
}
