{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-assist.local/contracts/curation.schema.json",
  "title": "Curation findings, change proposals, merge previews, and reviewed edge contracts",
  "$defs": {
    "Finding": {
      "type": "object",
      "required": [
        "id", "space_id", "finding_kind", "risk_tier", "severity", "status",
        "required_reviewer", "visibility_effect", "source_item_id",
        "source_revision_id", "detector_name", "detector_version", "rule_version",
        "evidence", "row_version", "created_at", "updated_at"
      ],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "inherited": {"type": "boolean"},
        "origin": {"enum": ["native", "inherited", "overlay"]},
        "overlay_grant_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "finding_kind": {"enum": ["lint", "exact_repeat", "curation_clear", "weak_complementary", "near_duplicate", "update", "potential_conflict", "semantic_edge", "replace", "merge", "curation_release", "curation_quarantine", "deactivate", "purge"]},
        "risk_tier": {"enum": ["T0", "T1", "T2", "T3"]},
        "severity": {"enum": ["blocker", "error", "warning", "info"]},
        "status": {"enum": ["pending", "approved", "rejected", "ignored", "obsolete", "applied", "apply_failed"]},
        "decision_mode": {"enum": ["automatic", "human"]},
        "required_reviewer": {"enum": ["none", "space_editor", "part_leader", "admin"]},
        "visibility_effect": {"enum": ["none", "badge", "agent_hidden", "publication_blocked"]},
        "proposed_action": {"enum": ["none", "provenance", "review_duplicate", "update", "review_conflict", "relation", "merge", "replace", "publish", "quarantine", "deactivate", "purge"]},
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_item_id": {"type": ["string", "null"], "format": "uuid"},
        "target_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "detector_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "detector_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "rule_version": {"type": "string", "minLength": 1, "maxLength": 120},
        "model_id": {"type": ["string", "null"], "maxLength": 200},
        "prompt_version": {"type": ["string", "null"], "maxLength": 200},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "evidence": {"type": "object"},
        "proposed_action_evidence": {"type": "object"},
        "reviewed_by": {"type": ["string", "null"], "maxLength": 64},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "review_reason": {"type": ["string", "null"], "maxLength": 2000},
        "row_version": {"type": "integer", "minimum": 1},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "updated_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"}
      },
      "additionalProperties": false
    },
    "FindingListResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor", "has_more", "corpus_closure_sha256"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Finding"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"},
        "has_more": {"type": "boolean"},
        "corpus_closure_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      },
      "additionalProperties": false
    },
    "FindingResponse": {
      "type": "object",
      "required": ["request_id", "finding"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "finding": {"$ref": "#/$defs/Finding"}
      },
      "additionalProperties": false
    },
    "ReviewFindingRequest": {
      "type": "object",
      "required": ["operation_id", "expected_finding_row_version", "decision", "reason"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_finding_row_version": {"type": "integer", "minimum": 1},
        "decision": {"enum": ["approve", "reject", "ignore"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "ReviewFindingResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "finding_id", "outcome", "row_version"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "finding_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "outcome": {"enum": ["approved", "rejected", "ignored", "obsolete"]},
        "row_version": {"type": "integer", "minimum": 2}
      },
      "additionalProperties": false
    },
    "DiffPane": {
      "type": "object",
      "required": ["label", "item_id", "revision_id", "content_sha256", "markdown"],
      "properties": {
        "label": {"enum": ["fork_base", "source_current", "target_current", "merge_source", "merge_target", "result"]},
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "content_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "markdown": {"type": "string"}
      },
      "additionalProperties": false
    },
    "ProposalPreviewRequest": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    },
    "ProposalPreviewResponse": {
      "type": "object",
      "required": [
        "request_id", "proposal_id", "finding_id", "proposal_kind",
        "proposal_version", "proposal_row_version", "finding_row_version",
        "state", "panes", "proposed_result", "preview_sha256", "stale",
        "current_source_revision_id", "current_target_revision_id",
        "current_target_row_version"
      ],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "proposal_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "finding_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "proposal_kind": {"enum": ["stable_source_update", "personal_to_part"]},
        "proposal_version": {"type": "integer", "minimum": 1},
        "proposal_row_version": {"type": "integer", "minimum": 1},
        "finding_row_version": {"type": "integer", "minimum": 1},
        "state": {"enum": ["pending", "approved", "rejected", "obsolete", "applied", "apply_failed"]},
        "panes": {"type": "array", "items": {"$ref": "#/$defs/DiffPane"}, "minItems": 3, "maxItems": 3},
        "proposed_result": {
          "type": "object",
          "required": ["content_sha256", "content_size_bytes", "markdown"],
          "properties": {
            "content_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
            "content_size_bytes": {"type": "integer", "minimum": 1},
            "markdown": {"type": "string"}
          },
          "additionalProperties": false
        },
        "preview_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "stale": {"type": "boolean"},
        "current_source_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "current_target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "current_target_row_version": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "RebaseProposalRequest": {
      "type": "object",
      "required": ["operation_id", "expected_proposal_row_version", "expected_finding_row_version", "expected_source_revision_id", "expected_target_revision_id"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_proposal_row_version": {"type": "integer", "minimum": 1},
        "expected_finding_row_version": {"type": "integer", "minimum": 1},
        "expected_source_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "expected_target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "proposed_markdown": {"type": "string", "minLength": 1, "maxLength": 2000000}
      },
      "additionalProperties": false
    },
    "RebaseProposalResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "old_proposal_id", "proposal_id", "finding_id", "proposal_series_id", "proposal_version", "proposal_row_version", "finding_row_version", "preview_sha256", "target_revision_id", "source_revision_id", "status"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "old_proposal_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "proposal_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "finding_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "proposal_series_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "proposal_version": {"type": "integer", "minimum": 1},
        "proposal_row_version": {"type": "integer", "minimum": 1},
        "finding_row_version": {"type": "integer", "minimum": 1},
        "preview_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "status": {"const": "pending_review"}
      },
      "additionalProperties": false
    },
    "ApplyProposalRequest": {
      "type": "object",
      "required": ["operation_id", "editor_session_id", "lease_id", "expected_proposal_row_version", "expected_finding_row_version", "expected_target_item_row_version", "expected_target_revision_id", "expected_source_revision_id", "preview_sha256"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "lease_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "expected_proposal_row_version": {"type": "integer", "minimum": 1},
        "expected_finding_row_version": {"type": "integer", "minimum": 1},
        "expected_target_item_row_version": {"type": "integer", "minimum": 1},
        "expected_target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "expected_source_revision_id": {"type": ["string", "null"], "format": "uuid"},
        "preview_sha256": {"$ref": "common.schema.json#/$defs/Sha256"}
      },
      "additionalProperties": false
    },
    "ApplyProposalResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "proposal_id", "finding_id", "target_item_id", "result_revision_id", "rescan_job_id", "item_row_version", "proposal_row_version", "finding_row_version", "status"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "proposal_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "finding_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "result_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "rescan_job_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "item_row_version": {"type": "integer", "minimum": 1},
        "proposal_row_version": {"type": "integer", "minimum": 1},
        "finding_row_version": {"type": "integer", "minimum": 1},
        "status": {"const": "applied"}
      },
      "additionalProperties": false
    },
    "MergePreviewRequest": {
      "type": "object",
      "required": ["source_item_id", "source_revision_id", "target_item_id", "target_revision_id", "result_markdown"],
      "properties": {
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "result_markdown": {"type": "string", "minLength": 1, "maxLength": 2000000}
      },
      "additionalProperties": false
    },
    "MergePreviewResponse": {
      "type": "object",
      "required": ["request_id", "source_revision_id", "target_revision_id", "panes", "edge_impact", "reference_impact", "preview_sha256", "stale"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "panes": {"type": "array", "items": {"$ref": "#/$defs/DiffPane"}, "minItems": 3, "maxItems": 3},
        "edge_impact": {"type": "object"},
        "reference_impact": {"type": "object"},
        "preview_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "MergeApplyRequest": {
      "type": "object",
      "required": ["operation_id", "source_item_id", "source_revision_id", "target_item_id", "target_revision_id", "result_markdown", "preview_sha256", "source_editor_session_id", "source_lease_id", "target_editor_session_id", "target_lease_id"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "result_markdown": {"type": "string", "minLength": 1, "maxLength": 2000000},
        "preview_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "source_editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_lease_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_editor_session_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_lease_id": {"$ref": "common.schema.json#/$defs/Uuid"}
      },
      "additionalProperties": false
    },
    "MergeApplyResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "merge_event_id", "source_item_id", "target_item_id", "result_revision_id", "redirect_relation_id", "status"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "merge_event_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "result_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "redirect_relation_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "status": {"const": "applied"}
      },
      "additionalProperties": false
    },
    "CurationPrecisionSample": {
      "type": "object",
      "required": ["evidence_sha256", "finding_id", "finding_kind", "model_id", "prompt_version", "reviewed_at_ms", "reviewed_by", "status", "verdict"],
      "properties": {
        "evidence_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "finding_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "finding_kind": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "reviewed_at_ms": {"type": "integer", "minimum": 0},
        "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 64},
        "status": {"enum": ["approved", "rejected", "ignored", "applied", "apply_failed"]},
        "verdict": {"enum": ["accepted", "rejected", "ignored"]}
      },
      "additionalProperties": false
    },
    "CurationShadowMetricsResponse": {
      "type": "object",
      "required": ["request_id", "finding_count", "human_reviewed_count", "mode", "model_accepted_count", "model_adjudicated_count", "model_automatic_execution_count", "model_ignored_count", "model_obsolete_count", "model_proposal_count", "model_rejected_count", "pending_count", "precision_denominator", "precision_numerator", "precision_ppm", "report_status", "risky_model_automatic_execution_count", "sample", "schema_version", "space_id", "t3_model_automatic_execution_count"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "finding_count": {"type": "integer", "minimum": 0},
        "human_reviewed_count": {"type": "integer", "minimum": 0},
        "mode": {"const": "shadow_proposal_only"},
        "model_accepted_count": {"type": "integer", "minimum": 0},
        "model_adjudicated_count": {"type": "integer", "minimum": 0},
        "model_automatic_execution_count": {"type": "integer", "minimum": 0},
        "model_ignored_count": {"type": "integer", "minimum": 0},
        "model_obsolete_count": {"type": "integer", "minimum": 0},
        "model_proposal_count": {"type": "integer", "minimum": 0},
        "model_rejected_count": {"type": "integer", "minimum": 0},
        "pending_count": {"type": "integer", "minimum": 0},
        "precision_denominator": {"type": "integer", "minimum": 0},
        "precision_numerator": {"type": "integer", "minimum": 0},
        "precision_ppm": {"type": ["integer", "null"], "minimum": 0, "maximum": 1000000},
        "report_status": {"enum": ["pass", "fail"]},
        "risky_model_automatic_execution_count": {"type": "integer", "minimum": 0},
        "sample": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/CurationPrecisionSample"}},
        "schema_version": {"const": 1},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "t3_model_automatic_execution_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ApproveEdgeRequest": {
      "type": "object",
      "required": ["operation_id", "expected_finding_row_version", "source_revision_id", "target_revision_id", "evidence_sha256", "reason"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_finding_row_version": {"type": "integer", "minimum": 1},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "evidence_sha256": {"$ref": "common.schema.json#/$defs/Sha256"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "DeactivateEdgeRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version", "reason"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"type": "integer", "minimum": 1},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2000}
      },
      "additionalProperties": false
    }
  }
}
