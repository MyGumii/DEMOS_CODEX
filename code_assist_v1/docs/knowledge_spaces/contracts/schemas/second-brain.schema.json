{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-assist.local/contracts/second-brain.schema.json",
  "title": "Registered Second Brain successor API shapes",
  "$defs": {
    "OperationRequest": {
      "type": "object",
      "required": ["operation_id"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "PersonalWikiCreateRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version", "display_name"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "PersonalWikiRenameRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version", "display_name"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "PersonalWikiVersionRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"}
      },
      "additionalProperties": false
    },
    "PersonalWikiArchiveRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "PersonalWikiRestoreRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "make_default": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "PersonalWikiProfile": {
      "type": "object",
      "required": ["space_id", "display_name", "lifecycle_status", "lifecycle_generation", "is_default", "archived_at", "archive_reason", "created_at", "updated_at", "row_version"],
      "properties": {
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "lifecycle_status": {"enum": ["active", "archived"]},
        "lifecycle_generation": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "is_default": {"type": "boolean"},
        "archived_at": {"type": ["string", "null"], "format": "date-time"},
        "archive_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"}
      },
      "additionalProperties": false
    },
    "PersonalWikiPageResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/PersonalWikiProfile"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"}
      },
      "additionalProperties": false
    },
    "HigherRoleSetRequest": {
      "type": "object",
      "required": ["operation_id", "assignee_user_id", "expected_current_assignment_id", "expected_current_assignment_generation", "expected_current_assignment_row_version", "expected_space_row_version", "enable_writes", "reason"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "assignee_user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/UserId"}, {"type": "null"}]},
        "expected_current_assignment_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "expected_current_assignment_generation": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "expected_current_assignment_row_version": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "expected_space_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "enable_writes": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "oneOf": [
        {
          "properties": {
            "expected_current_assignment_id": {"type": "null"},
            "expected_current_assignment_generation": {"type": "null"},
            "expected_current_assignment_row_version": {"type": "null"}
          }
        },
        {
          "properties": {
            "expected_current_assignment_id": {"$ref": "common.schema.json#/$defs/Uuid"},
            "expected_current_assignment_generation": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
            "expected_current_assignment_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"}
          }
        }
      ],
      "additionalProperties": false
    },
    "HigherRoleMutationResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "status", "org_unit_id", "space_id", "assignment_id", "assignment_generation", "assignment_row_version", "space_row_version", "space_generation", "write_enabled"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "status": {"enum": ["assigned", "replaced", "updated", "ended"]},
        "org_unit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "assignment_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "assignment_generation": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "assignment_row_version": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "space_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "space_generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "write_enabled": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "HigherRoleStatusResponse": {
      "type": "object",
      "required": ["request_id", "org_unit_id", "role", "space_id", "space_row_version", "space_generation", "write_enabled", "assignment_id", "assignment_generation", "assignment_row_version", "assignee_user_id", "assignee_display_name"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "org_unit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "role": {"enum": ["team_leader", "responsibility_executive"]},
        "space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "space_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "space_generation": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "write_enabled": {"type": "boolean"},
        "assignment_id": {"$ref": "common.schema.json#/$defs/NullableUuid"},
        "assignment_generation": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "assignment_row_version": {"$ref": "common.schema.json#/$defs/NullablePositiveVersion"},
        "assignee_user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/UserId"}, {"type": "null"}]},
        "assignee_display_name": {"type": ["string", "null"], "minLength": 1, "maxLength": 120}
      },
      "additionalProperties": false
    },
    "DistributionTarget": {
      "type": "object",
      "required": ["org_unit_id", "kind", "name", "org_path", "target_scope_kind", "target_scope_id"],
      "properties": {
        "org_unit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "kind": {"enum": ["team", "part"]},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "org_path": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "target_scope_kind": {"const": "org_unit"},
        "target_scope_id": {"$ref": "common.schema.json#/$defs/Uuid"}
      },
      "additionalProperties": false
    },
    "DistributionTargetListResponse": {
      "type": "object",
      "required": ["request_id", "source_space_id", "items"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "items": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/DistributionTarget"}}
      },
      "additionalProperties": false
    },
    "DistributionCreateRequest": {
      "type": "object",
      "required": ["operation_id", "source_item_id", "source_revision_id", "target_org_unit_id", "target_scope_kind", "target_scope_id", "reason"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_org_unit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_scope_kind": {"enum": ["org_unit", "native_space"]},
        "target_scope_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000}
      },
      "additionalProperties": false
    },
    "DistributionRevokeRequest": {
      "type": "object",
      "required": ["operation_id", "expected_row_version", "reason", "break_glass"],
      "properties": {
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "expected_row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "break_glass": {"type": "boolean"},
        "confirmation": {"type": "string", "minLength": 1, "maxLength": 256}
      },
      "additionalProperties": false
    },
    "DistributionMutationResponse": {
      "type": "object",
      "required": ["request_id", "operation_id", "status", "grant_id", "source_space_id", "row_version", "revoked"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "operation_id": {"$ref": "common.schema.json#/$defs/OperationId"},
        "status": {"enum": ["created", "revoked"]},
        "grant_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"},
        "revoked": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "DistributionGrant": {
      "type": "object",
      "required": ["grant_id", "source_space_id", "source_item_id", "source_revision_id", "target_org_unit_id", "target_scope_kind", "target_scope_id", "grant_mode", "source_role_assignment_id", "created_by_user_id", "reason", "created_at", "revoked_at", "revoked_by_user_id", "revoke_mode", "revoke_reason", "updated_at", "row_version"],
      "properties": {
        "grant_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_org_unit_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "target_scope_kind": {"enum": ["org_unit", "native_space"]},
        "target_scope_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "grant_mode": {"const": "read_only"},
        "source_role_assignment_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "created_by_user_id": {"$ref": "common.schema.json#/$defs/UserId"},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "created_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "revoked_at": {"oneOf": [{"$ref": "common.schema.json#/$defs/UtcTimestamp"}, {"type": "null"}]},
        "revoked_by_user_id": {"oneOf": [{"$ref": "common.schema.json#/$defs/UserId"}, {"type": "null"}]},
        "revoke_mode": {"type": ["string", "null"], "enum": ["ordinary", "break_glass", null]},
        "revoke_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "updated_at": {"$ref": "common.schema.json#/$defs/UtcTimestamp"},
        "row_version": {"$ref": "common.schema.json#/$defs/PositiveVersion"}
      },
      "additionalProperties": false
    },
    "DistributionPageResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor"],
      "properties": {
        "request_id": {"$ref": "common.schema.json#/$defs/RequestId"},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/DistributionGrant"}},
        "next_cursor": {"$ref": "common.schema.json#/$defs/Cursor"}
      },
      "additionalProperties": false
    },
    "ManagementSearchRequest": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1, "maxLength": 500},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10},
        "cursor": {"type": ["string", "null"], "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "SelectedViewDescriptor": {
      "type": "object",
      "required": ["selected_view_space_id", "kind", "history_only", "corpus_sources"],
      "properties": {
        "selected_view_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "kind": {"enum": ["personal", "part", "team", "responsibility"]},
        "history_only": {"type": "boolean"},
        "corpus_sources": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": ["source_space_id", "kind", "inherited", "capabilities"],
            "properties": {
              "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
              "kind": {"enum": ["personal", "part", "team", "responsibility", "distribution_overlay"]},
              "inherited": {"type": "boolean"},
              "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "maxItems": 32}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "RankedDocument": {
      "type": "object",
      "required": ["item_id", "revision_id", "source_space_id", "score", "provenance"],
      "properties": {
        "item_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "source_space_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "provenance": {"type": "array", "items": {"enum": ["fts", "one_hop", "two_hop", "temporal"]}, "uniqueItems": true, "maxItems": 4}
      },
      "additionalProperties": false
    },
    "TemporalValue": {
      "oneOf": [
        {"type": "object", "required": ["precision", "value"], "properties": {"precision": {"const": "instant"}, "value": {"type": "string", "format": "date-time"}}, "additionalProperties": false},
        {"type": "object", "required": ["precision", "value", "timezone"], "properties": {"precision": {"const": "date"}, "value": {"type": "string", "format": "date"}, "timezone": {"const": "Asia/Seoul"}}, "additionalProperties": false}
      ]
    },
    "TemporalMetadata": {
      "type": "object",
      "required": ["registered_at", "content_modified_at", "revision_no"],
      "properties": {
        "registered_at": {"type": "string", "format": "date-time"},
        "content_modified_at": {"type": "string", "format": "date-time"},
        "revision_no": {"type": "integer", "minimum": 1},
        "source_modified_at": {"anyOf": [{"$ref": "#/$defs/TemporalValue"}, {"type": "null"}]},
        "information_effective_at": {"anyOf": [{"$ref": "#/$defs/TemporalValue"}, {"type": "null"}]},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "ProjectionManifestV2": {
      "type": "object",
      "required": ["schema_version", "revision_id", "revision_no", "canonical_prefix_length", "canonical_prefix_sha256", "footer_schema", "rendered_length", "rendered_sha256", "snapshot_as_of_event_id"],
      "properties": {
        "schema_version": {"const": 2},
        "revision_id": {"$ref": "common.schema.json#/$defs/Uuid"},
        "revision_no": {"type": "integer", "minimum": 1},
        "canonical_prefix_length": {"type": "integer", "minimum": 0},
        "canonical_prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "footer_schema": {"const": "knowledge-footer-v2"},
        "rendered_length": {"type": "integer", "minimum": 0},
        "rendered_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "snapshot_as_of_event_id": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "SuccessorPageResponse": {
      "type": "object",
      "required": ["request_id", "items", "next_cursor"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "items": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
        "next_cursor": {"type": ["string", "null"], "maxLength": 4096}
      },
      "additionalProperties": false
    },
    "SuccessorDetailResponse": {
      "type": "object",
      "required": ["request_id", "data"],
      "properties": {
        "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    },
    "SuccessorContractExample": {
      "type": "object",
      "required": ["selected_view", "ranked_documents", "mandatory_context", "temporal", "projection"],
      "properties": {
        "selected_view": {"$ref": "#/$defs/SelectedViewDescriptor"},
        "ranked_documents": {"type": "array", "items": {"$ref": "#/$defs/RankedDocument"}},
        "mandatory_context": {"type": "array", "maxItems": 4, "items": {"type": "object"}},
        "temporal": {"$ref": "#/$defs/TemporalMetadata"},
        "projection": {"$ref": "#/$defs/ProjectionManifestV2"}
      },
      "additionalProperties": false
    }
  }
}
